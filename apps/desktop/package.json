{
  "name": "@gaa/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for GAA",
  "author": "GAA",
  "main": "main.cjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "start": "electron .",
    "installer": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^35.1.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "electronVersion": "35.1.0",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "appId": "com.gaa.app",
    "productName": "GAA",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/client-dist/**/*",
      "build/daemon-dist/**/*",
      "build/protocol-dist/**/*"
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
